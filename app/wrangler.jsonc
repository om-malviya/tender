// Cloudflare deployment of the frontend: a Worker that only serves the static Vite build (free tier).
// Unknown paths fall back to index.html so client-side routes like /pay/... load directly.
{
  "name": "tender",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
