# Copy to .env and fill in. NEVER commit .env. Use fresh testnet-only keys.

# --- Unichain Sepolia (chain 1301) ---
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
# second provider used when the first rate-limits (default: PublicNode); WHITECHAIN_SEPOLIA_RPC_FALLBACK works the same
UNICHAIN_SEPOLIA_RPC_FALLBACK=https://unichain-sepolia-rpc.publicnode.com
UNICHAIN_USDC=0x31d0220469e10c4E71834a79b1f276d740d3768F
DEPLOYER_PK=
MERCHANT_PK=
DEMO=                     # set after DeployUnichain prints the DemoToken address
UNISWAP_API_KEY=          # developers.uniswap.org/dashboard (server-side only)

# --- Whitechain Sepolia (chain 1874) ---
WHITECHAIN_SEPOLIA_RPC=https://rpc.testnet.whitechain.io/

# --- Hedera testnet ---
HEDERA_MERCHANT_ID=
HEDERA_MERCHANT_KEY=
HEDERA_AGENT_ID=
HEDERA_AGENT_KEY=
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
